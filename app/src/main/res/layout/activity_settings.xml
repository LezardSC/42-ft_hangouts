<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:navigationIcon="@drawable/ic_arrow_back"
        android:navigationContentDescription="@string/navigate_up"
        android:title="@string/settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp" >

            <Button
                android:id="@+id/buttonHeaderColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_outlined"
                android:textColor="?attr/colorOnSurface"
                android:textAllCaps="false"
                android:gravity="center_vertical|start"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:drawableStart="@drawable/ic_palette"
                android:drawablePadding="16dp"
                android:text="@string/header_color" />

            <Button
                android:id="@+id/buttonLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_outlined"
                android:textColor="?attr/colorOnSurface"
                android:textAllCaps="false"
                android:gravity="center_vertical|start"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:drawableStart="@drawable/ic_language"
                android:drawablePadding="16dp"
                android:text="@string/language" />

            <Button
                android:id="@+id/buttonTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_outlined"
                android:textColor="?attr/colorOnSurface"
                android:textAllCaps="false"
                android:gravity="center_vertical|start"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:drawableStart="@drawable/ic_theme"
                android:drawablePadding="16dp"
                android:text="@string/theme" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
